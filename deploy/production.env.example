# Supply these through the process manager/host secret store. Do not commit real values.
DJANGO_SETTINGS_MODULE=plan.settings_production
SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters
ALLOWED_HOSTS=plansoko.example.com
SITE_ORIGIN=https://plansoko.example.com
TRUST_HTTPS_PROXY=True
SECURE_HSTS_SECONDS=300
DB_NAME=replace-database-name
DB_USER=replace-database-user
DB_PASSWORD=replace-database-password
DB_HOST=replace-database-host
DB_PORT=5432
# verify-full for a remote database with trusted certificates; disable only on a secured local connection.
DB_SSLMODE=verify-full
MEDIA_ROOT=/srv/plansoko/data/public
PRIVATE_MEDIA_ROOT=/srv/plansoko/data/private
STATIC_ROOT=/srv/plansoko/data/static
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER=replace-daraja-consumer
DARAJA_SECRET=replace-daraja-secret
DARAJA_PASSKEY=replace-daraja-passkey
DARAJA_SHORTCODE=replace-daraja-shortcode
PAYMENT_INITIATION_ENABLED=False
MPESA_CALLBACK_URL=https://plansoko.example.com/api/payments/callback/
